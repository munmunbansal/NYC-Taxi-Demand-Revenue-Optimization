      <aliases enabled='yes' />
      <column caption='Airport fee' datatype='real' name='[Airport_fee]' role='measure' type='quantitative' />
      <column caption='Distance Category' datatype='string' name='[Calculation_0120987381051392]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [trip_distance] &lt;= 3 THEN &quot;Short&quot;&#13;&#10;ELSEIF [trip_distance] &lt;= 10 THEN &quot;Medium&quot;&#13;&#10;ELSEIF [trip_distance] &lt;= 20 THEN &quot;Long&quot;&#13;&#10;ELSE &quot;Very Long&quot;&#13;&#10;END' />
      </column>
      <column caption='Payment Type Name' datatype='string' name='[Calculation_0120987384946689]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [payment_type]&#13;&#10;WHEN 0 THEN &quot;Flex Fare&quot;&#13;&#10;WHEN 1 THEN &quot;Credit Card&quot;&#13;&#10;WHEN 2 THEN &quot;Cash&quot;&#13;&#10;WHEN 3 THEN &quot;No Charge&quot;&#13;&#10;WHEN 4 THEN &quot;Dispute&quot;&#13;&#10;WHEN 5 THEN &quot;Unknown&quot;&#13;&#10;ELSE &quot;Other&quot;&#13;&#10;END' />
      </column>
